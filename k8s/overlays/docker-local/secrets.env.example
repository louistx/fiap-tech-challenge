# Copie este arquivo para "secrets.env" (gitignored) e ajuste os valores.
# Os valores de ConnectionStrings__DefaultConnection abaixo devem bater com o
# banco provisionado pelo Terraform em infra/environments/dev (mesmos
# postgres_user/postgres_password/postgres_db das variáveis do módulo database).
ConnectionStrings__DefaultConnection=Host=postgres-service.techchallenge.svc.cluster.local;Port=5432;Database=TechChallenge;Username=postgres;Password=Dev@123456
Jwt__SecretKey=dev-secret-com-no-minimo-32-caracteres-1234
Seed__AdminPassword=admin
