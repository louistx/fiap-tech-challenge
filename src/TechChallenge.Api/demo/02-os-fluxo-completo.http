@baseUrl = http://localhost:8080

@clienteId = aaaaaaaa-0000-0000-0000-000000000001
@vendedorId = aaaaaaaa-0000-0000-0000-000000000003
@mecanicoId = aaaaaaaa-0000-0000-0000-000000000005
@veiculoId = aaaaaaaa-0000-0000-0000-000000000008
@servicoRevisaoId = aaaaaaaa-0000-0000-0000-000000000009
@servicoDiagnosticoId = aaaaaaaa-0000-0000-0000-000000000010
@produtoFiltroId = aaaaaaaa-0000-0000-0000-000000000011

### 1. Criar OS como vendedor
# Gera notificacao via logger para grupo Mecanico: "Nova OS na fila".
# @name criarOs
POST {{baseUrl}}/api/v1/ordens-servico
Authorization: Bearer {{vendedorToken}}
Content-Type: application/json

{
  "descricao": "Cliente relata barulho no motor e solicita revisão demo",
  "clienteResponsavelId": "{{clienteId}}",
  "funcionarioResponsavelId": "{{vendedorId}}",
  "veiculoId": "{{veiculoId}}",
  "servicos": [
    {
      "id": "{{servicoRevisaoId}}",
      "quantidade": 1
    }
  ],
  "produtos": [
    {
      "id": "{{produtoFiltroId}}",
      "quantidade": 2
    }
  ]
}

> {%
client.global.set("osCompletaId", response.body);
%}

### 2. Consultar status exclusivo da OS recebida
GET {{baseUrl}}/api/v1/ordens-servico/{{osCompletaId}}/status
Authorization: Bearer {{vendedorToken}}
Accept: application/json

### 3. Consultar OS recebida
GET {{baseUrl}}/api/v1/ordens-servico/{{osCompletaId}}
Authorization: Bearer {{vendedorToken}}
Accept: application/json

### 4. Atribuir OS ao mecanico
PATCH {{baseUrl}}/api/v1/ordens-servico/{{osCompletaId}}/atribuir
Authorization: Bearer {{mecanicoToken}}
Content-Type: application/json

{
  "mecanicoId": "{{mecanicoId}}"
}

### 5. Registrar diagnostico complementar
PATCH {{baseUrl}}/api/v1/ordens-servico/{{osCompletaId}}/diagnostico
Authorization: Bearer {{mecanicoToken}}
Content-Type: application/json

{
  "servicos": [
    {
      "id": "{{servicoDiagnosticoId}}",
      "quantidade": 1
    }
  ],
  "produtos": []
}

### 6. Enviar orcamento
PATCH {{baseUrl}}/api/v1/ordens-servico/{{osCompletaId}}/orcamento/enviar
Authorization: Bearer {{mecanicoToken}}

### 7. Aprovar orcamento
PATCH {{baseUrl}}/api/v1/ordens-servico/{{osCompletaId}}/aprovar
Authorization: Bearer {{vendedorToken}}

### 8. Finalizar OS
# Baixa 2 unidades do produto "Filtro de oleo demo".
PATCH {{baseUrl}}/api/v1/ordens-servico/{{osCompletaId}}/finalizar
Authorization: Bearer {{mecanicoToken}}

### 9. Entregar OS
PATCH {{baseUrl}}/api/v1/ordens-servico/{{osCompletaId}}/entregar
Authorization: Bearer {{vendedorToken}}

### 10. Consultar OS entregue
# Copie o campo codigoAcompanhamento para o arquivo 04.
GET {{baseUrl}}/api/v1/ordens-servico/{{osCompletaId}}
Authorization: Bearer {{vendedorToken}}
Accept: application/json

### 11. Conferir inventario apos baixa
GET {{baseUrl}}/api/v1/produtos
Authorization: Bearer {{vendedorToken}}
Accept: application/json
