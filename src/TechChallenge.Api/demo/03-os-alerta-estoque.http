@baseUrl = http://localhost:8080

@clienteId = aaaaaaaa-0000-0000-0000-000000000001
@vendedorId = aaaaaaaa-0000-0000-0000-000000000003
@mecanicoId = aaaaaaaa-0000-0000-0000-000000000005
@veiculoId = aaaaaaaa-0000-0000-0000-000000000008
@servicoDiagnosticoId = aaaaaaaa-0000-0000-0000-000000000010
@produtoPoucoEstoqueId = aaaaaaaa-0000-0000-0000-000000000012

### 1. Criar OS para demonstrar falta de estoque
# @name criarOsAlerta
POST {{baseUrl}}/api/v1/ordens-servico
Authorization: Bearer {{vendedorToken}}
Content-Type: application/json

{
  "descricao": "Demo de falta de estoque durante diagnostico",
  "clienteResponsavelId": "{{clienteId}}",
  "funcionarioResponsavelId": "{{vendedorId}}",
  "veiculoId": "{{veiculoId}}"
}

> {%
client.global.set("osAlertaId", response.body);
%}

### 2. Atribuir OS ao mecanico
PATCH {{baseUrl}}/api/v1/ordens-servico/{{osAlertaId}}/atribuir
Authorization: Bearer {{mecanicoToken}}
Content-Type: application/json

{
  "mecanicoId": "{{mecanicoId}}"
}

### 3. Tentar registrar produto acima do estoque
# Esperado: 400, mensagem "Estoque insuficiente..."
# Observe logs:
# - Notificacao para funcionarios com funcao Administrador
# - Notificacao para funcionario {{mecanicoId}}
PATCH {{baseUrl}}/api/v1/ordens-servico/{{osAlertaId}}/diagnostico
Authorization: Bearer {{mecanicoToken}}
Content-Type: application/json

{
  "servicos": [
    {
      "id": "{{servicoDiagnosticoId}}",
      "quantidade": 1
    }
  ],
  "produtos": [
    {
      "id": "{{produtoPoucoEstoqueId}}",
      "quantidade": 3
    }
  ]
}

### 4. Consultar OS apos tentativa bloqueada
GET {{baseUrl}}/api/v1/ordens-servico/{{osAlertaId}}
Authorization: Bearer {{vendedorToken}}
Accept: application/json

### 5. Conferir produto com pouco estoque
GET {{baseUrl}}/api/v1/produtos/{{produtoPoucoEstoqueId}}
Authorization: Bearer {{vendedorToken}}
Accept: application/json
